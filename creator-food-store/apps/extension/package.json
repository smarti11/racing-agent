{
  "name": "extension",
  "version": "0.0.0",
  "private": true,
  "displayName": "GoodCart — Save Food Products",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build"
  },
  "dependencies": {
    "@repo/affiliate-engine": "workspace:*",
    "plasmo": "^0.89.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.7.2"
  },
  "manifest": {
    "host_permissions": [
      "https://www.amazon.com/*",
      "https://www.walmart.com/*",
      "https://www.instacart.com/*",
      "https://thrivemarket.com/*",
      "https://www.iherb.com/*",
      "https://www.vitacost.com/*",
      "https://www.target.com/*"
    ],
    "permissions": ["activeTab", "storage"]
  }
}
