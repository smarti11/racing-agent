generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CREATOR
  CONSUMER
  ADMIN
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FoodCategory {
  SNACKS
  BEVERAGES
  PANTRY
  PRODUCE
  DAIRY
  FROZEN
  DELI
  BAKERY
  MEAL_KITS
  SUPPLEMENTS
  SPECIALTY
  KITCHEN_TOOLS
}

enum AffiliateNetwork {
  AMAZON
  IMPACT
  CJ
  SHAREASALE
  RAKUTEN
  DIRECT
  SKIMLINKS
}

enum ConversionStatus {
  PENDING
  CONFIRMED
  REVERSED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum CollectionVisibility {
  PUBLIC
  PRIVATE
  COLLABORATIVE
}

enum PriceAlertStatus {
  ACTIVE
  TRIGGERED
  CANCELLED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  name          String?
  handle        String    @unique
  bio           String?
  avatarUrl     String?
  role          UserRole  @default(CONSUMER)
  instagramUrl  String?
  tiktokUrl     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  creatorProfile CreatorProfile?
  accounts       Account[]
  sessions       Session[]
  collections    Collection[]
  creatorProducts CreatorProduct[]
  trackedLinks   TrackedLink[]
  conversions    Conversion[]
  earnings       Earning[]
  following      Follow[]       @relation("Following")
  followers      Follow[]       @relation("Followers")
  savedProducts  SavedProduct[]
  priceAlerts    PriceAlert[]
  moderationItems ModerationItem[] @relation("Moderator")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model CreatorProfile {
  id                   String            @id @default(cuid())
  userId               String            @unique
  applicationStatus    ApplicationStatus @default(APPROVED)
  followerCount        Int               @default(0)
  payoutTier           String            @default("standard")
  stripeConnectId      String?
  stripeOnboarded      Boolean           @default(false)
  totalEarnings        Float             @default(0)
  pendingEarnings      Float             @default(0)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Product {
  id           String       @id @default(cuid())
  name         String
  brand        String?
  description  String?
  imageUrl     String?
  sourceUrl    String
  retailer     String
  retailerId   String?
  category     FoodCategory
  dietaryTags  String       @default("[]")
  priceCents   Int?
  currency     String       @default("USD")
  isApproved   Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  affiliateOffers AffiliateOffer[]
  creatorProducts CreatorProduct[]
  trackedLinks    TrackedLink[]
  conversions     Conversion[]
  savedProducts   SavedProduct[]
  priceAlerts     PriceAlert[]
  priceHistory    PriceHistory[]

  @@index([retailer, retailerId])
  @@index([category])
}

model AffiliateOffer {
  id                  String           @id @default(cuid())
  productId           String
  network             AffiliateNetwork
  commissionRate      Float
  affiliateUrlTemplate String
  networkProductId    String?
  expiresAt           DateTime?
  isActive            Boolean          @default(true)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  trackedLinks TrackedLink[]

  @@index([productId, network])
}

model Collection {
  id          String               @id @default(cuid())
  userId      String
  name        String
  description String?
  visibility  CollectionVisibility @default(PUBLIC)
  sortOrder   Int                  @default(0)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  creatorProducts CreatorProduct[]
}

model CreatorProduct {
  id           String   @id @default(cuid())
  creatorId    String
  productId    String
  collectionId String?
  note         String?
  sortOrder    Int      @default(0)
  isPinned     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  creator    User        @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)

  @@unique([creatorId, productId])
  @@index([creatorId, sortOrder])
}

model TrackedLink {
  id            String   @id @default(cuid())
  shortCode     String   @unique
  creatorId     String
  productId     String
  offerId       String?
  destinationUrl String
  clickCount    Int      @default(0)
  createdAt     DateTime @default(now())

  creator  User            @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  product  Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  offer    AffiliateOffer? @relation(fields: [offerId], references: [id], onDelete: SetNull)
  clicks   Click[]
  conversions Conversion[]

  @@index([shortCode])
}

model Click {
  id        String   @id @default(cuid())
  linkId    String
  referrer  String?
  userAgent String?
  ipHash    String?
  country   String?
  createdAt DateTime @default(now())

  link TrackedLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId, createdAt])
}

model Conversion {
  id              String           @id @default(cuid())
  linkId          String?
  creatorId       String
  productId       String
  networkOrderId  String
  network         AffiliateNetwork
  orderAmount     Float
  commission      Float
  status          ConversionStatus @default(PENDING)
  subId           String?
  confirmedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  link    TrackedLink? @relation(fields: [linkId], references: [id], onDelete: SetNull)
  creator User         @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([network, networkOrderId])
  @@index([creatorId, status])
}

model Earning {
  id          String       @id @default(cuid())
  creatorId   String
  amount      Float
  periodStart DateTime
  periodEnd   DateTime
  status      PayoutStatus @default(PENDING)
  stripeTransferId String?
  paidAt      DateTime?
  createdAt   DateTime     @default(now())

  creator User @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([creatorId, status])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

model SavedProduct {
  id           String   @id @default(cuid())
  userId       String
  productId    String
  collectionId String?
  isPurchased  Boolean  @default(false)
  isGifted     Boolean  @default(false)
  createdAt    DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model PriceAlert {
  id            String           @id @default(cuid())
  userId        String
  productId     String
  targetPriceCents Int
  status        PriceAlertStatus @default(ACTIVE)
  lastCheckedAt DateTime?
  notifiedAt    DateTime?
  createdAt     DateTime         @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([status])
}

model PriceHistory {
  id         String   @id @default(cuid())
  productId  String
  priceCents Int
  recordedAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, recordedAt])
}

model ModerationItem {
  id          String   @id @default(cuid())
  productId   String?
  userId      String?
  reason      String
  status      String   @default("pending")
  moderatorId String?
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())

  moderator User? @relation("Moderator", fields: [moderatorId], references: [id], onDelete: SetNull)
}
